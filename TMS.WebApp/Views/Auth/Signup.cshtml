@model TMS.DataAccess.ViewModels.SignupViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - TMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="~/Content/Style.css" rel="stylesheet" />
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="logo">
            <i class="bi bi-ticket-perforated"></i>
            <h2>Ticket Management System</h2>
            <p class="text-secondary" style="font-size: 0.9rem;">
                @if (Model?.SignupStep == "otp")
                {<text>Verify your email</text>}
                else
                {<text>Create your account</text>}
            </p>
        </div>

        @using (Html.BeginForm("Signup", "Auth", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            if (Model?.SignupStep == "otp")
            {
                @Html.HiddenFor(m => m.FullName)
                @Html.HiddenFor(m => m.MobileNumber)
                @Html.HiddenFor(m => m.Email)
                @Html.HiddenFor(m => m.PasswordHash)
                @Html.HiddenFor(m => m.OtpEmail)
                @Html.HiddenFor(m => m.SignupStep)
                @Html.HiddenFor(m => m.DepartmentId)

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <p class="form-control-plaintext fw-bold">@Model.OtpEmail</p>
                </div>

                <div class="mb-3">
                    <label for="otpCode" class="form-label">Enter OTP Code</label>
                    <input type="text" name="OtpCode" id="otpCode" class="form-control" placeholder="6-digit code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" />
                    @Html.ValidationMessage("OtpCode", "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <button type="submit" class="btn btn-primary w-100">Verify & Create Account</button>

                <div class="mt-3 text-center">
                    <button type="button" id="resendOtpBtn" class="btn btn-link" onclick="resendOtp('@Model.OtpEmail')">Resend Code</button>
                    <span id="resendTimer" class="text-muted small" style="display:none;"></span>
                </div>
            }
            else
            {
                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Enter your full name" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.MobileNumber, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control", placeholder = "Enter your mobile number" })
                    @Html.ValidationMessageFor(m => m.MobileNumber, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.DepartmentId, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.DepartmentId, (SelectList)ViewBag.Departments, "-- Select Department --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Create a password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm your password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
                </div>

                <button type="submit" class="btn btn-primary w-100">Create Account</button>
            }
        }

        <div class="auth-footer">
            Already have an account? <a href="@Url.Action("Login", "Auth")">Sign in</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function resendOtp(email) {
            var btn = document.getElementById('resendOtpBtn');
            var timer = document.getElementById('resendTimer');
            btn.disabled = true;
            btn.style.display = 'none';
            timer.style.display = 'inline';
            timer.textContent = 'Resending...';

            fetch('@Url.Action("ResendOtp", "Auth")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'email=' + encodeURIComponent(email) + '&__RequestVerificationToken=' + document.querySelector('input[name="__RequestVerificationToken"]').value
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    timer.textContent = 'Code sent!';
                    setTimeout(function() { btn.disabled = false; btn.style.display = 'inline'; timer.style.display = 'none'; }, 3000);
                } else {
                    timer.textContent = d.error || 'Failed to resend';
                    setTimeout(function() { btn.disabled = false; btn.style.display = 'inline'; timer.style.display = 'none'; }, 3000);
                }
            })
            .catch(() => {
                timer.textContent = 'Error occurred';
                setTimeout(function() { btn.disabled = false; btn.style.display = 'inline'; timer.style.display = 'none'; }, 3000);
            });
        }
    </script>
</body>
</html>
