@model TMS.DataAccess.ViewModels.UserEditViewModel
@{
    ViewBag.Title = "Edit User";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Edit User - @Model.FullName</h4>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row mb-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.MobileNumber, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.MobileNumber, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" value="@Model.Email" readonly />
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.RoleId, new { @class = "form-label" })
                    <select name="RoleId" class="form-select">
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r.Id" @(r.Id == Model.RoleId ? "selected" : "")>@r.Name</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.DepartmentId, new { @class = "form-label" })
                    <select name="DepartmentId" class="form-select">
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Id" @(d.Id == Model.DepartmentId ? "selected" : "")>@d.Name</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Update User</button>
        }
    </div>
</div>
