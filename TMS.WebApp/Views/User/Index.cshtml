@model TMS.DataAccess.ViewModels.UserListViewModel
@{
    ViewBag.Title = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Users</h4>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add User</a>
</div>

<form method="post" id="searchForm" data-url="@Url.Action("Index")">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PageSize)
    @Html.HiddenFor(m => m.PageNumber, new { id = "PageNumber" })
    @Html.HiddenFor(m => m.SortColumn, new { id = "SortColumn" })
    @Html.HiddenFor(m => m.SortDirection, new { id = "SortDirection" })

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label mb-1 small text-muted">Search User</label>
                    @Html.HiddenFor(m => m.SearchTerm, new { id = "SearchTerm" })
                    <select id="SearchName" class="form-control" style="width:100%;" placeholder="Search by name..."></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1 small text-muted">Role</label>
                    @Html.DropDownListFor(m => m.RoleId, (SelectList)ViewBag.Roles, "All Roles", new { @class = "form-select" })
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="button" id="searchBtn" class="btn btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
                    <button type="reset" id="resetbutton" class="btn btn-outline-secondary">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <div id="resultContainer"></div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span id="PageItems" class="text-muted small"></span>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="prevButton" class="btn btn-sm btn-outline-secondary">Previous</button>
                <span id="buttonlist" class="page-buttons"></span>
                <button type="button" id="nextButton" class="btn btn-sm btn-outline-secondary">Next</button>
            </div>
        </div>
    </div>
</form>

@section scripts {
    <script src="~/PageScripts/UserListScript.js"></script>
}
