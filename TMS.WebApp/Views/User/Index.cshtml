@model TMS.DataAccess.ViewModels.UserListViewModel
@{
    ViewBag.Title = "Users";
}
@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Users</h4>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add User</a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by name or email..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-3">
                @Html.DropDownList("roleId", (SelectList)ViewBag.Roles, "All Roles", new { @class = "form-select" })
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Approval</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>@u.FullName</td>
                                <td>@u.EmailId</td>
                                <td>@(u.MobileNumber ?? "-")</td>
                                <td>
                                    @if (u.UserId == (int)ViewBag.CurrentUserId)
                                    {
                                        <span class="badge bg-info">@u.RoleName</span>
                                    }
                                    else
                                    {
                                        <select class="form-select form-select-sm change-role" data-userid="@u.UserId" title="Change role">
                                            @foreach (var r in (SelectList)ViewBag.Roles)
                                            {
                                                <option value="@r.Value" @(u.RoleId.ToString() == r.Value ? "selected" : "")>@r.Text</option>
                                            }
                                        </select>
                                    }
                                </td>
                                <td>@u.DepartmentName</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Approval">
                                        <input type="radio" class="btn-check approval-radio" name="approval_@u.UserId" id="rejected_@u.UserId" value="rejected" data-userid="@u.UserId" @(u.IsApproved == 0 ? "checked" : "") />
                                        <label class="btn btn-outline-danger" for="rejected_@u.UserId">Rejected</label>
                                        <input type="radio" class="btn-check approval-radio" name="approval_@u.UserId" id="awaiting_@u.UserId" value="awaiting" data-userid="@u.UserId" @(u.IsApproved == null ? "checked" : "") />
                                        <label class="btn btn-outline-warning" for="awaiting_@u.UserId">Awaiting</label>
                                        <input type="radio" class="btn-check approval-radio" name="approval_@u.UserId" id="approved_@u.UserId" value="approved" data-userid="@u.UserId" @(u.IsApproved == 1 ? "checked" : "") />
                                        <label class="btn btn-outline-success" for="approved_@u.UserId">Approved</label>
                                    </div>
                                </td>
                                <td>@u.CreatedOn.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = u.UserId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    @if (u.UserId != (int)ViewBag.CurrentUserId)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger delete-user" data-userid="@u.UserId" data-name="@u.FullName"><i class="bi bi-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No users found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalRows > Model.PageSize)
    {
        <div class="card-footer bg-white">
            <nav>
                <ul class="pagination pagination-sm mb-0 justify-content-center">
                    @for (int i = 1; i <= Math.Ceiling((double)Model.TotalRows / Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, searchTerm = Model.SearchTerm, roleId = Model.RoleId })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@section scripts {
    <script>
        $(function () {
            $('.change-role').change(function () {
                var sel = $(this);
                var userId = sel.data('userid');
                var roleId = sel.val();
                $.post('@Url.Action("ChangeRole", "User")', { userId: userId, roleId: roleId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                    .done(function (r) {
                        if (r.success) { showToast(r.message, 'info'); sel.data('orig', roleId); }
                        else { showToast(r.error, 'error'); sel.val(sel.data('orig')); }
                    })
                    .fail(function () { showToast('Error changing role', 'error'); sel.val(sel.data('orig')); });
            }).each(function () {
                $(this).data('orig', $(this).val());
            });

            $('.approval-radio').change(function () {
                var radio = $(this);
                var userId = radio.data('userid');
                var approval = radio.val();
                $.post('@Url.Action("SetApproval", "User")', { userId: userId, approval: approval, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                    .done(function (r) {
                        if (r.success) { showToast(r.message, 'success'); }
                        else { showToast(r.error, 'error'); }
                    })
                    .fail(function () { showToast('Error updating approval', 'error'); });
            });

            $('.delete-user').click(function () {
                var btn = $(this);
                var userId = btn.data('userid');
                var name = btn.data('name');
                showConfirm('Delete User', 'Are you sure you want to delete "' + name + '"? They will be deactivated and unable to log in. Their history will be preserved.', 'Delete', function () {
                    $.post('@Url.Action("Delete", "User")', { userId: userId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                        .done(function (r) {
                            if (r.success) { showToast(r.message, 'success'); setTimeout(function () { window.location.reload(); }, 800); }
                            else { showToast(r.error, 'error'); }
                        })
                        .fail(function () { showToast('Error deleting user', 'error'); });
                });
            });
        });
    </script>
}
