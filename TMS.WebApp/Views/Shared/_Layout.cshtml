<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/Content/Style.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
</head>
<body>

    <div class="layout-wrapper">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-logo">
                <i class="bi bi-ticket-perforated"></i>
                <span>TMS</span>
            </div>

            <nav class="sidebar-nav">
                <a href="@Url.Action("Index", "Dashboard")" class="sidebar-nav-item">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a href="@Url.Action("Index", "Ticket")" class="sidebar-nav-item">
                    <i class="bi bi-ticket"></i>
                    <span>Tickets</span>
                </a>
                @if (!User.IsInRole("Support Executive"))
                {
                    <a href="@Url.Action("Create", "Ticket")" class="sidebar-nav-item">
                        <i class="bi bi-plus-circle"></i>
                        <span>Raise Ticket</span>
                    </a>
                }
                @if (User.IsInRole("Support Executive"))
                {
                    <a href="@Url.Action("MyAssigned", "Ticket")" class="sidebar-nav-item">
                        <i class="bi bi-person-check"></i>
                        <span>My Tickets</span>
                    </a>
                }
                @if (User.IsInRole("Administrator"))
                {
                    <a href="@Url.Action("Index", "User")" class="sidebar-nav-item">
                        <i class="bi bi-people"></i>
                        <span>Manage Users</span>
                    </a>
                }
                <div class="sidebar-divider"></div>
                <div class="sidebar-section-title">More</div>
                <a href="@Url.Action("About", "Home")" class="sidebar-nav-item">
                    <i class="bi bi-info-circle"></i>
                    <span>About</span>
                </a>
                <a href="@Url.Action("Contact", "Home")" class="sidebar-nav-item">
                    <i class="bi bi-chat-left-text"></i>
                    <span>Contact</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user-info">
                    <i class="bi bi-person-circle"></i>
                    <span>@(User.Identity.Name ?? "Guest")</span>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.Action("Index", "Profile")" class="sidebar-nav-item" style="margin: 2px 0; padding: 6px 12px; font-size: 0.85rem; color: rgba(255,255,255,0.7) !important;">
                        <i class="bi bi-person-gear" style="font-size: 1rem; width: 20px; color: rgba(255,255,255,0.5);"></i>
                        <span>My Profile</span>
                    </a>
                    <a href="@Url.Action("Logout", "Auth")" class="sidebar-logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Auth")" class="sidebar-logout">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login</span>
                    </a>
                }
            </div>
        </aside>

        <div class="main-content">
            <div class="mobile-header">
                <button class="sidebar-toggle-mobile" id="sidebarToggle" title="Toggle Sidebar">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="content">
                @RenderBody()
            </div>

            <footer>
                <p>&copy; @DateTime.Now.Year Ticket Management System. All rights reserved.</p>
            </footer>
        </div>
    </div>

    @RenderSection("modals", required: false)

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content confirm-modal-content">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body text-center p-4">
                    <div class="confirm-icon-wrapper mb-3">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h4 class="modal-title fw-bold mb-2 justify-content-center" id="confirmModalTitle">Confirm</h4>
                    <p class="text-secondary mb-4" id="confirmModalMessage"></p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger px-4" id="confirmModalBtn">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["info"] != null)
    {
        <script>
            $(function () { showToast('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["info"])))', 'info'); });
        </script>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/PageScripts/AppShared.js?v=@DateTime.Now.Ticks"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
