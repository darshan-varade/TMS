@{
    Layout = null;
    ViewBag.Title = "Error";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - TMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <div class="container" style="min-height: 100vh; display: flex; align-items: center; justify-content: center;">
        <div class="text-center p-5 bg-white rounded-3 shadow-sm" style="max-width: 480px;">
            <div class="display-1 text-danger mb-3"><i class="bi bi-exclamation-octagon-fill"></i></div>
            <h1 class="h3 mb-2">Something went wrong</h1>
            <p class="text-secondary mb-4">An unexpected error occurred while processing your request. Please try again.</p>
            <a href="@Url.Content("~/")" class="btn btn-primary"><i class="bi bi-house-door"></i> Go to Dashboard</a>
        </div>
    </div>
</body>
</html>
