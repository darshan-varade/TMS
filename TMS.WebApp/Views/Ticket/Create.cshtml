@model TMS.DataAccess.ViewModels.TicketAddViewModel
@{
    ViewBag.Title = "Raise Ticket";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">Raise New Ticket</h4>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Create", "Ticket", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Title, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter ticket title" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 5, placeholder = "Describe the issue in detail" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.CategoryId, new { @class = "form-label" })
                    <select name="CategoryId" class="form-select">
                        <option value="">-- Select Category --</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.PriorityId, new { @class = "form-label" })
                    <select name="PriorityId" class="form-select">
                        <option value="">-- Select Priority --</option>
                        @foreach (var p in Model.Priorities)
                        {
                            <option value="@p.Id">@p.Name @(!string.IsNullOrEmpty(p.AdditionalInfo) ? "(" + p.AdditionalInfo + ")" : "")</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.PriorityId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Attachment (optional)</label>
                <input type="file" name="file" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Submit Ticket</button>
        }
    </div>
</div>
