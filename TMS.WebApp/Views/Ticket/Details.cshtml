@model TMS.DataAccess.ViewModels.TicketDetailViewModel
@using System.Linq

@functions {
    public string GetInitials(string fullName)
    {
        var initials = "";
        if (!string.IsNullOrEmpty(fullName))
        {
            var parts = fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 0 && !string.IsNullOrEmpty(parts[0])) initials += parts[0][0];
            if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1])) initials += parts[1][0];
        }
        if (string.IsNullOrEmpty(initials)) initials = "U";
        return initials.ToUpper();
    }
}

@{
    ViewBag.Title = "Ticket " + Model.TicketNumber;
    bool isAdmin = (bool)ViewBag.IsAdmin;
    bool isSupport = (bool)ViewBag.IsSupport;
    bool isEmployee = !(isAdmin || isSupport);
    bool isOwner = Model.CreatedByUserId == (int)ViewBag.CurrentUserId;
    bool canEdit = isAdmin || (isOwner && !Model.AssignedToUserId.HasValue);
    bool canDelete = isAdmin || (isOwner && !Model.AssignedToUserId.HasValue);
    bool isAssignedToMe = Model.AssignedToUserId == (int)ViewBag.CurrentUserId;
    bool canManageTicket = isAdmin || (isSupport && isAssignedToMe);

    var timelineItems = new List<dynamic>();
    if (Model.Comments != null)
    {
        foreach (var c in Model.Comments.Where(c => !(c.IsInternal && !(isAdmin || isSupport))))
        {
            timelineItems.Add(new { Type = "comment", Date = c.CreatedOn, Item = c });
        }
    }
    if (Model.Activities != null)
    {
        foreach (var a in Model.Activities)
        {
            timelineItems.Add(new { Type = "activity", Date = a.CreatedOn, Item = a });
        }
    }
    bool newestFirst = isAdmin || isSupport;
    var sortedTimeline = newestFirst
        ? timelineItems.OrderByDescending(t => t.Date).ToList()
        : timelineItems.OrderBy(t => t.Date).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="breadcrumb-jira mb-0">
        <a href="@Url.Action("Index")"><i class="bi bi-arrow-left"></i> Back to tickets</a>
        <span class="mx-2 text-muted">/</span>
        <span class="fw-semibold">@Model.TicketNumber</span>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editTicketModal"><i class="bi bi-pencil"></i> Edit</button>
        }
        @if (canDelete)
        {
            <form method="post" action="@Url.Action("Delete", "Ticket")" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this ticket? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.TicketId" />
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
    </div>
</div>

<div class="ticket-header-title">@Model.Title</div>

<div class="row g-4">
    <div class="col-lg-4 col-xl-3 order-lg-2">
        <div class="mb-3 d-grid gap-2">
            @if (isAdmin)
            {
                <button type="button" class="btn btn-outline-success w-100 py-2 fw-semibold" data-action="assign" data-ticket-id="@Model.TicketId"><i class="bi bi-person-check"></i> Assign Ticket</button>
            }
            @if (canManageTicket)
            {
                <button type="button" class="btn btn-outline-primary w-100 py-2 fw-semibold" data-action="updatestatus" data-ticket-id="@Model.TicketId"><i class="bi bi-arrow-repeat"></i> Update Status</button>
            }
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header"><h6 class="mb-0">Details</h6></div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="width: 45%; font-size: 0.85rem;">Status</th>
                            <td class="pe-0 text-end">
                                <span class="badge @(Model.StatusName == "Closed" ? "bg-success" : Model.StatusName == "Resolved" ? "bg-info" : Model.StatusName == "In Progress" ? "bg-primary" : Model.StatusName == "Assigned" ? "bg-warning" : "bg-secondary")">@Model.StatusName</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Priority</th>
                            <td class="pe-0 text-end">
                                <span class="badge @(Model.PriorityName == "Critical" ? "bg-danger" : Model.PriorityName == "High" ? "bg-warning" : Model.PriorityName == "Medium" ? "bg-primary" : "bg-secondary")">@Model.PriorityName</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Category</th>
                            <td class="pe-0 text-end fw-semibold text-dark" style="font-size: 0.875rem;">@Model.CategoryName</td>
                        </tr>
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Assignee</th>
                            <td class="pe-0 text-end fw-medium" style="font-size: 0.875rem;">@(Model.AssignedToName ?? "Unassigned")</td>
                        </tr>
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Reporter</th>
                            <td class="pe-0 text-end fw-medium" style="font-size: 0.875rem;">@Model.CreatedByName</td>
                        </tr>
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Due Date</th>
                            <td class="pe-0 text-end text-muted" style="font-size: 0.825rem;">@Model.DueDate.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                        @if (Model.ResolvedOn.HasValue)
                        {
                            <tr>
                                <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Resolved On</th>
                                <td class="pe-0 text-end text-muted" style="font-size: 0.825rem;">@Model.ResolvedOn.Value.ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                        <tr>
                            <th class="ps-0 text-muted fw-semibold" style="font-size: 0.85rem;">Created</th>
                            <td class="pe-0 text-end text-muted" style="font-size: 0.825rem;">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-8 col-xl-9 order-lg-1">
        <div class="key-details-card mb-4">
            <div class="key-details-header p-3 d-flex align-items-center gap-3">
                <div class="avatar-circle flex-shrink-0" style="width: 38px; height: 38px; border-radius: 50%; background-color: #E2E8F0; color: #475569; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.95rem;">
                    @GetInitials(Model.CreatedByName)
                </div>
                <div>
                    <div class="fw-bold text-dark">@Model.CreatedByName</div>
                    <div class="text-muted small">raised this request on @Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</div>
                </div>
            </div>
            <div class="p-3">
                <h6 class="text-muted small fw-semibold text-uppercase mb-2" style="letter-spacing: 0.05em;">Description</h6>
                <div style="white-space: pre-line; line-height: 1.6; color: var(--text-primary); font-size: 0.95rem;">@Model.Description</div>
            </div>
        </div>

        @if (!isEmployee)
        {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Attachments <span class="badge bg-light text-secondary border ms-1">@(Model.Attachments != null ? Model.Attachments.Count : 0)</span></h6>
            </div>
            <div class="card-body">
                @if (Model.Attachments != null && Model.Attachments.Any())
                {
                    <div class="attachment-grid">
                        @foreach (var att in Model.Attachments)
                        {
                            var previewUrl = Url.Action("PreviewFile", "Ticket", new { attachmentId = att.AttachmentId });
                            var downloadUrl = Url.Action("DownloadFile", "Ticket", new { attachmentId = att.AttachmentId });
                            var fileType = System.IO.Path.GetExtension(att.OriginalFileName);
                            <div class="attachment-item-card attachment-preview" data-preview-url="@previewUrl" data-download-url="@downloadUrl" data-filename="@att.OriginalFileName" data-filesize="@(att.FileSize / 1024) KB" data-filetype="@fileType">
                                <div class="attachment-item-preview">
                                    @if (att.OriginalFileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || 
                                         att.OriginalFileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || 
                                         att.OriginalFileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || 
                                         att.OriginalFileName.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
                                         att.OriginalFileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <img src="@downloadUrl" alt="@att.OriginalFileName" />
                                    }
                                    else if (att.OriginalFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="bi bi-file-earmark-pdf-fill text-danger fs-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-text text-secondary fs-1"></i>
                                    }
                                </div>
                                <div class="attachment-item-meta">
                                    <span class="attachment-item-name" title="@att.OriginalFileName">@att.OriginalFileName</span>
                                    <span class="attachment-item-size">@(att.FileSize / 1024) KB</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No attachments uploaded yet.</p>
                }
            </div>
        </div>
        }

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center border-bottom-0 pb-0">
                <h6 class="mb-0">Activity</h6>
                @if (!isEmployee)
                {
                    <ul class="nav nav-tabs border-bottom-0 activity-tabs" id="activityTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" onclick="filterActivityTab('all', this)">All</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" onclick="filterActivityTab('comments', this)">Comments</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" onclick="filterActivityTab('history', this)">History</button>
                        </li>
                    </ul>
                }
            </div>
            
            <div class="card-body">
                <div class="comment-editor-wrapper d-flex gap-3 mb-4">
                    <div class="avatar-circle flex-shrink-0" style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem;">
                        @GetInitials(User.Identity.Name ?? "User")
                    </div>
                    <div class="flex-grow-1">
                        <div id="commentCollapsed" class="comment-collapsed-box border rounded px-3 py-2 text-muted" onclick="expandCommentEditor()" style="border-radius: 8px;">
                            @if (isAdmin || (isSupport && isAssignedToMe))
                            {
                                <span>Add internal note or Reply to customer...</span>
                            }
                            else if (isSupport)
                            {
                                <span>Add an internal note...</span>
                            }
                            else
                            {
                                <span>Add a comment...</span>
                            }
                        </div>
                        
                        <div id="commentExpanded" class="comment-expanded-box border rounded p-3 d-none@((isAdmin || (isSupport && isAssignedToMe)) ? "" : " internal-note-mode")">
                            <form method="post" action="@Url.Action("AddComment", "Ticket")" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId" value="@Model.TicketId" />
                                <input type="hidden" name="isInternal" id="commentIsInternal" value="@((isAdmin || (isSupport && isAssignedToMe)) ? "false" : "true")" />
                                
                                @if (isAdmin || (isSupport && isAssignedToMe))
                                {
                                    <ul class="nav nav-tabs border-bottom-0 mb-3 comment-type-tabs">
                                        <li class="nav-item">
                                            <button type="button" class="nav-link active comment-tab-reply" onclick="setCommentType(false)">Reply to customer</button>
                                        </li>
                                        <li class="nav-item">
                                            <button type="button" class="nav-link comment-tab-internal" onclick="setCommentType(true)">Add internal note</button>
                                        </li>
                                    </ul>
                                }
                                
                                <div class="mb-3">
                                    <textarea name="comment" id="commentTextarea" class="form-control border-0 p-0" rows="3" placeholder="Type your comment..." style="box-shadow: none !important; resize: none; font-size: 0.925rem;" required></textarea>
                                </div>
                                
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top flex-wrap gap-2" style="border-color: var(--border) !important;">
                                    <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                                        <label class="btn btn-link text-muted p-1 m-0" style="cursor: pointer;" title="Attach file">
                                            <i class="bi bi-paperclip fs-5"></i>
                                            <input type="file" name="file" class="d-none" onchange="handleCommentFileChange(this)" />
                                        </label>
                                        <span id="commentFileName" class="text-muted small text-truncate" style="max-width: 140px;"></span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2" onclick="collapseCommentEditor()">Cancel</button>
                                        <button type="submit" class="btn btn-sm btn-primary px-3 py-2">Save</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="timeline-stream">
                    @if (sortedTimeline.Any())
                    {
                        foreach (var item in sortedTimeline)
                        {
                            if (item.Type == "comment")
                            {
                                var c = (TMS.DataAccess.ViewModels.CommentViewModel)item.Item;
                                <div class="timeline-item timeline-item-comment p-3 mb-3 border rounded" data-type="comment" style="@(c.IsInternal ? "background-color: rgba(245, 158, 11, 0.04); border-color: rgba(245, 158, 11, 0.2) !important;" : "border-color: var(--border) !important;")">
                                    <div class="d-flex gap-3">
                                        <div class="avatar-circle flex-shrink-0" style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;">
                                            @GetInitials(c.CreatedByName)
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="fw-semibold text-dark">@c.CreatedByName</span>
                                                <span class="text-muted small">@c.CreatedOn.ToString("dd MMM yyyy HH:mm")</span>
                                                @if (c.IsInternal)
                                                {
                                                    <span class="badge bg-warning text-dark ms-2" style="font-size: 0.725rem;">Internal Note</span>
                                                }
                                            </div>
                                            <div class="comment-body mt-2" style="white-space: pre-line; line-height: 1.5; color: var(--text-primary); font-size: 0.925rem;">
                                                @c.Comment
                                            </div>
                                            @if (c.Attachments != null && c.Attachments.Any())
                                            {
                                                <div class="attachment-grid mt-3">
                                                    @foreach (var att in c.Attachments)
                                                    {
                                                        var cPreviewUrl = Url.Action("PreviewFile", "Ticket", new { attachmentId = att.AttachmentId });
                                                        var cDownloadUrl = Url.Action("DownloadFile", "Ticket", new { attachmentId = att.AttachmentId });
                                                        var cFileType = System.IO.Path.GetExtension(att.OriginalFileName);
                                                        <div class="attachment-item-card attachment-preview" data-preview-url="@cPreviewUrl" data-download-url="@cDownloadUrl" data-filename="@att.OriginalFileName" data-filesize="@(att.FileSize / 1024) KB" data-filetype="@cFileType">
                                                            <div class="attachment-item-preview">
                                                                 @if (att.OriginalFileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || 
                                                                      att.OriginalFileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || 
                                                                      att.OriginalFileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || 
                                                                      att.OriginalFileName.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
                                                                      att.OriginalFileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                                                                 {
                                                                     <img src="@cDownloadUrl" alt="@att.OriginalFileName" />
                                                                 }
                                                                 else if (att.OriginalFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                                 {
                                                                     <i class="bi bi-file-earmark-pdf-fill text-danger fs-1"></i>
                                                                 }
                                                                 else
                                                                 {
                                                                     <i class="bi bi-file-earmark-text text-secondary fs-1"></i>
                                                                 }
                                                            </div>
                                                            <div class="attachment-item-meta">
                                                                <span class="attachment-item-name" title="@att.OriginalFileName">@att.OriginalFileName</span>
                                                                <span class="attachment-item-size">@(att.FileSize / 1024) KB</span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (item.Type == "activity")
                            {
                                var a = (TMS.DataAccess.ViewModels.ActivityViewModel)item.Item;
                                <div class="timeline-item timeline-item-activity mb-3" data-type="activity">
                                    <div class="d-flex gap-3 align-items-start">
                                        <div class="avatar-circle flex-shrink-0" style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--main-bg); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border);">
                                            <i class="bi bi-info-circle" style="font-size: 0.85rem;"></i>
                                        </div>
                                        <div class="flex-grow-1 pt-1">
                                            <div class="d-flex align-items-center flex-wrap gap-2" style="font-size: 0.875rem;">
                                                <span class="fw-semibold text-dark">@a.CreatedByName</span>
                                                <span class="text-muted">updated the ticket:</span>
                                                <span class="fw-medium text-secondary">@a.ActivityTypeName</span>
                                                <span class="text-muted small ms-auto">@a.CreatedOn.ToString("dd MMM yyyy HH:mm")</span>
                                            </div>
                                            <div class="activity-content mt-2 small">
                                                @if (!string.IsNullOrEmpty(a.Remarks))
                                                {
                                                    <div class="text-muted fst-italic mb-1">@a.Remarks</div>
                                                }
                                                @if (!string.IsNullOrEmpty(a.OldValue) && !string.IsNullOrEmpty(a.NewValue))
                                                {
                                                    <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                                        <span class="badge bg-light text-secondary border px-2 py-1">@a.OldValue</span>
                                                        <i class="bi bi-arrow-right text-muted"></i>
                                                        <span class="badge bg-primary-light text-primary border border-primary px-2 py-1">@a.NewValue</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="text-muted small text-center my-4">No activity or comments recorded yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section modals {
    @if (canEdit)
    {
        <div class="modal fade" id="editTicketModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    @using (Html.BeginForm("Update", "Ticket", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TicketId" value="@Model.TicketId" />
                        <input type="hidden" name="TicketNumber" value="@Model.TicketNumber" />
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Ticket @Model.TicketNumber</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Title</label>
                                <input type="text" name="Title" class="form-control" value="@Model.Title" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea name="Description" class="form-control" rows="4" required>@Model.Description</textarea>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Category</label>
                                    <select name="CategoryId" class="form-select">
                                        @foreach (var c in (SelectList)ViewBag.Categories)
                                        {
                                            <option value="@c.Value" @(c.Selected ? "selected" : "")>@c.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Priority</label>
                                    <select name="PriorityId" class="form-select">
                                        @foreach (var p in (SelectList)ViewBag.Priorities)
                                        {
                                            <option value="@p.Value" @(p.Selected ? "selected" : "")>@p.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="ticketActionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" id="ticketActionModalContent">
            </div>
        </div>
    </div>

}

@section scripts {
    <script src="~/PageScripts/TicketDetailScript.js?v=@DateTime.Now.Ticks"></script>
    <script>
        function expandCommentEditor() {
            $('#commentCollapsed').addClass('d-none');
            $('#commentExpanded').removeClass('d-none');
            $('#commentTextarea').focus();
        }

        function collapseCommentEditor() {
            $('#commentCollapsed').removeClass('d-none');
            $('#commentExpanded').addClass('d-none');
            $('#commentTextarea').val('');
            $('#commentFileName').text('');
            $('input[type="file"][name="file"]').val('');
        }

        function setCommentType(isInternal) {
            $('#commentIsInternal').val(isInternal ? 'true' : 'false');
            $('.comment-type-tabs .nav-link').removeClass('active');
            
            if (isInternal) {
                $('.comment-tab-internal').addClass('active');
                $('#commentExpanded').addClass('internal-note-mode');
            } else {
                $('.comment-tab-reply').addClass('active');
                $('#commentExpanded').removeClass('internal-note-mode');
            }
        }

        function handleCommentFileChange(input) {
            if (input.files && input.files[0]) {
                $('#commentFileName').text(input.files[0].name);
            } else {
                $('#commentFileName').text('');
            }
        }

        function filterActivityTab(tabType, element) {
            $('.activity-tabs .nav-link').removeClass('active');
            $(element).addClass('active');
            
            if (tabType === 'all') {
                $('.timeline-item').removeClass('d-none');
            } else if (tabType === 'comments') {
                $('.timeline-item[data-type="comment"]').removeClass('d-none');
                $('.timeline-item[data-type="activity"]').addClass('d-none');
            } else if (tabType === 'history') {
                $('.timeline-item[data-type="activity"]').removeClass('d-none');
                $('.timeline-item[data-type="comment"]').addClass('d-none');
            }
        }

    </script>
}
