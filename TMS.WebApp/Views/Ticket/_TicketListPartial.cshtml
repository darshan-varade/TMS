@model TMS.DataAccess.ViewModels.TicketListViewModel
@{
    bool isAdmin = (bool)ViewBag.IsAdmin;
    bool isSupport = (bool)ViewBag.IsSupport;
    bool isEmployee = (bool)ViewBag.IsEmployee;
    int currentUserId = (int)ViewBag.CurrentUserId;
    var supportUsers = (SelectList)ViewBag.SupportUsers;
}

<input type="hidden" id="TotalRows" value="@Model.TotalRows" />

<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr>
            <th class="ps-3 sortable" data-column="TicketNumber">Ticket <span class="sort-icon"></span></th>
            <th class="sortable" data-column="Title">Title <span class="sort-icon"></span></th>
            <th>Category</th>
            @if (!isEmployee)
            {
                <th class="sortable" data-column="PriorityName">Priority <span class="sort-icon"></span></th>
            }
            <th class="sortable" data-column="StatusName">Status <span class="sort-icon"></span></th>
            @if (!isEmployee)
            {
                <th>Created By</th>
            }
            <th>Assigned To</th>
            @if (!isEmployee)
            {
                <th class="text-center">Messages</th>
            }
            <th class="sortable" data-column="CreatedOn">Created <span class="sort-icon"></span></th>
            <th class="pe-3 text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Tickets != null && Model.Tickets.Any())
        {
            foreach (var t in Model.Tickets)
            {
                <tr>
                    <td class="ps-3"><a href="@Url.Action("Details", new { id = t.TicketId })" class="fw-semibold text-decoration-none">@t.TicketNumber</a></td>
                    <td class="fw-medium">@t.Title</td>
                    <td>@t.CategoryName</td>
                    @if (!isEmployee)
                    {
                        <td><span class="badge @(t.PriorityName == "Critical" ? "bg-danger" : t.PriorityName == "High" ? "bg-warning" : t.PriorityName == "Medium" ? "bg-primary" : "bg-secondary")">@t.PriorityName</span></td>
                    }
                    <td><span class="badge @(t.StatusName == "Closed" ? "bg-success" : t.StatusName == "Resolved" ? "bg-info" : t.StatusName == "In Progress" ? "bg-primary" : t.StatusName == "Assigned" ? "bg-warning" : "bg-secondary")">@t.StatusName</span></td>
                    @if (!isEmployee)
                    {
                        <td>@t.CreatedByName</td>
                    }
                    <td>
                        @if (isAdmin)
                        {
                            <select class="form-select form-select-sm assign-user" data-ticketid="@t.TicketId" data-orig="@(t.AssignedToUserId.HasValue ? t.AssignedToUserId.Value.ToString() : "")" title="Assign support executive">
                                <option value="">-- Unassigned --</option>
                                @foreach (var u in supportUsers)
                                {
                                    <option value="@u.Value" @(t.AssignedToUserId.HasValue && t.AssignedToUserId.Value.ToString() == u.Value ? "selected" : "")>@u.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="text-muted fw-medium">@(t.AssignedToName ?? "-")</span>
                        }
                    </td>
                    @if (!isEmployee)
                    {
                        <td class="text-center"><span class="badge bg-light">@t.ConversationCount</span></td>
                    }
                    <td class="text-secondary" style="font-size: 0.9rem;">@t.CreatedOn.ToString("dd MMM yyyy")</td>
                    <td class="pe-3 text-end" style="white-space: nowrap;">
                        <a href="@Url.Action("Details", new { id = t.TicketId })" class="btn btn-sm btn-outline-primary py-1 px-2" title="View Details"><i class="bi bi-eye"></i></a>
                        @if (isAdmin || (isEmployee && t.CreatedBy == currentUserId && !t.AssignedToUserId.HasValue))
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger delete-ticket py-1 px-2" data-ticketid="@t.TicketId" data-title="@t.Title" title="Delete Ticket"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="@(isEmployee ? 7 : 10)" class="text-center text-muted py-4">No tickets found.@(!isSupport ? " <a href=\"" + Url.Action("Create") + "\">Raise a ticket</a>" : "")</td></tr>
        }
    </tbody>
</table>
