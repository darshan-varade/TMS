@model TMS.DataAccess.ViewModels.TicketAssignViewModel

<div class="modal-header">
    <h5 class="modal-title">Assign Ticket - @Model.TicketNumber</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

@using (Html.BeginForm("Assign", "Ticket", FormMethod.Post, new { id = "assignForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TicketId)

    <div class="modal-body">
        <p class="mb-0"><strong>Ticket:</strong> @Model.Title</p>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(m => m.AssignedToUserId, new { @class = "form-label" }) <span class="text-danger">*</span>
            @Html.DropDownListFor(m => m.AssignedToUserId, new SelectList(Model.SupportUsers ?? new List<TMS.DataAccess.ViewModels.DropdownViewModel>(), "Id", "Name"), "-- Select Support Executive --", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.AssignedToUserId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Assign Ticket</button>
    </div>
}
