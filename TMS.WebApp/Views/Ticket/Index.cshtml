@model TMS.DataAccess.ViewModels.TicketListViewModel
@{
    ViewBag.Title = "Tickets";
    bool isSupport = (bool)ViewBag.IsSupport;
    bool myAssignedOnly = (bool)ViewBag.MyAssignedOnly;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@(myAssignedOnly ? "My Assigned Tickets" : "Tickets")</h2>
        <p class="text-secondary mb-0" style="font-size: 0.9rem;">View and manage the ticketing lifecycle</p>
    </div>
    <div class="d-flex gap-2">
        @if (myAssignedOnly)
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary d-flex align-items-center gap-2"><i class="bi bi-arrow-left"></i> All Tickets</a>
        }
        else if (isSupport)
        {
            <a href="@Url.Action("MyAssigned")" class="btn btn-outline-primary d-flex align-items-center gap-2"><i class="bi bi-person-check"></i> My Assigned Tickets</a>
        }
        @if (!isSupport)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary d-flex align-items-center gap-2"><i class="bi bi-plus-lg"></i> Raise Ticket</a>
        }
    </div>
</div>

<form method="post" id="searchForm" data-url="@Url.Action(myAssignedOnly ? "MyAssigned" : "Index")">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PageSize)
    @Html.HiddenFor(m => m.PageNumber, new { id = "PageNumber" })
    @Html.HiddenFor(m => m.SortColumn, new { id = "SortColumn" })
    @Html.HiddenFor(m => m.SortDirection, new { id = "SortDirection" })

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label mb-1 small text-secondary fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Search</label>
                    @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Search tickets..." })
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small text-secondary fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Status</label>
                    @Html.DropDownListFor(m => m.StatusId, (SelectList)ViewBag.Statuses, "All Statuses", new { @class = "form-select" })
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small text-secondary fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Priority</label>
                    @Html.DropDownListFor(m => m.PriorityId, (SelectList)ViewBag.Priorities, "All Priorities", new { @class = "form-select" })
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1 small text-secondary fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Category</label>
                    @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.Categories, "All Categories", new { @class = "form-select" })
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1 small text-secondary fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Date From</label>
                    @Html.TextBoxFor(m => m.DateFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1 small text-secondary fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Date To</label>
                    @Html.TextBoxFor(m => m.DateTo, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button type="button" id="searchBtn" class="btn btn-primary d-flex align-items-center gap-2"><i class="bi bi-search"></i> Filter</button>
                    <button type="reset" id="resetbutton" class="btn btn-outline-secondary">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <div id="resultContainer"></div>
            </div>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2 border-0 py-3" style="background: transparent;">
            <span id="PageItems" class="text-muted small"></span>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="prevButton" class="btn btn-sm btn-outline-secondary">Previous</button>
                <span id="buttonlist" class="page-buttons"></span>
                <button type="button" id="nextButton" class="btn btn-sm btn-outline-secondary">Next</button>
            </div>
        </div>
    </div>
</form>

@section scripts {
    <script src="~/PageScripts/TicketListScript.js"></script>
}

