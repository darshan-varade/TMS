@model TMS.DataAccess.ViewModels.TicketListViewModel
@{
    ViewBag.Title = "Tickets";
    bool isAdmin = (bool)ViewBag.IsAdmin;
    bool isSupport = (bool)ViewBag.IsSupport;
    bool isEmployee = (bool)ViewBag.IsEmployee;
    int currentUserId = (int)ViewBag.CurrentUserId;
    bool myAssignedOnly = (bool)ViewBag.MyAssignedOnly;
}
@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@(myAssignedOnly ? "My Assigned Tickets" : "Tickets")</h4>
    <div>
        @if (myAssignedOnly)
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> All Tickets</a>
        }
        else if (isSupport)
        {
            <a href="@Url.Action("MyAssigned")" class="btn btn-outline-primary"><i class="bi bi-person-check"></i> My Assigned Tickets</a>
        }
        @if (!isSupport)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Raise Ticket</a>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search tickets..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-2">
                @Html.DropDownList("statusId", (SelectList)ViewBag.Statuses, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.DropDownList("priorityId", (SelectList)ViewBag.Priorities, "All Priorities", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "All Categories", new { @class = "form-select" })
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket</th>
                        <th>Title</th>
                        <th>Category</th>
                        @if (!isEmployee)
                        {
                            <th>Priority</th>
                        }
                        <th>Status</th>
                        @if (!isEmployee)
                        {
                            <th>Created By</th>
                        }
                        <th>Assigned To</th>
                        @if (!isEmployee)
                        {
                            <th>Messages</th>
                        }
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tickets.Any())
                    {
                        foreach (var t in Model.Tickets)
                        {
                            <tr>
                                <td><a href="@Url.Action("Details", new { id = t.TicketId })">@t.TicketNumber</a></td>
                                <td>@t.Title</td>
                                <td>@t.CategoryName</td>
                                @if (!isEmployee)
                                {
                                    <td><span class="badge @(t.PriorityName == "Critical" ? "bg-danger" : t.PriorityName == "High" ? "bg-warning" : t.PriorityName == "Medium" ? "bg-primary" : "bg-secondary")">@t.PriorityName</span></td>
                                }
                                <td><span class="badge @(t.StatusName == "Closed" ? "bg-success" : t.StatusName == "Resolved" ? "bg-info" : t.StatusName == "In Progress" ? "bg-primary" : t.StatusName == "Assigned" ? "bg-warning" : "bg-secondary")">@t.StatusName</span></td>
                                @if (!isEmployee)
                                {
                                    <td>@t.CreatedByName</td>
                                }
                                <td>
                                    @if (isAdmin)
                                    {
                                        <select class="form-select form-select-sm assign-user" data-ticketid="@t.TicketId" title="Assign support executive">
                                            <option value="">-- Unassigned --</option>
                                            @foreach (var u in (SelectList)ViewBag.SupportUsers)
                                            {
                                                <option value="@u.Value" @(t.AssignedToUserId.HasValue && t.AssignedToUserId.Value.ToString() == u.Value ? "selected" : "")>@u.Text</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @(t.AssignedToName ?? "-")
                                    }
                                </td>
                                @if (!isEmployee)
                                {
                                    <td><span class="badge bg-light text-dark">@t.ConversationCount</span></td>
                                }
                                <td>@t.CreatedOn.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = t.TicketId })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    @if (isAdmin || (isEmployee && t.CreatedBy == currentUserId && !t.AssignedToUserId.HasValue))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger delete-ticket" data-ticketid="@t.TicketId" data-title="@t.Title"><i class="bi bi-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="@(isEmployee ? 7 : 10)" class="text-center text-muted py-4">No tickets found.@(!(bool)ViewBag.IsSupport ? " <a href=\"" + Url.Action("Create") + "\">Raise a ticket</a>" : "")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalRows > Model.PageSize)
    {
        <div class="card-footer bg-white">
            <nav>
                <ul class="pagination pagination-sm mb-0 justify-content-center">
                    @for (int i = 1; i <= Math.Ceiling((double)Model.TotalRows / Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="@Url.Action(myAssignedOnly ? "MyAssigned" : "Index", new { page = i, searchTerm = Model.SearchTerm, statusId = Model.StatusId, priorityId = Model.PriorityId, categoryId = Model.CategoryId, dateFrom = Model.DateFrom, dateTo = Model.DateTo, sortColumn = Model.SortColumn, sortDirection = Model.SortDirection })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@section scripts {
    <script>
        $(function () {
            $('.assign-user').change(function () {
                var sel = $(this);
                var ticketId = sel.data('ticketid');
                var assignedToUserId = sel.val();
                $.post('@Url.Action("Assign", "Ticket")', { TicketId: ticketId, AssignedToUserId: assignedToUserId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                    .done(function (r) {
                        if (r.success) {
                            showToast(r.message, 'info');
                            setTimeout(function () { window.location.reload(); }, 800);
                        } else {
                            showToast(r.message || 'Error assigning ticket', 'error');
                            sel.val(sel.data('orig'));
                        }
                    })
                    .fail(function () { showToast('Error assigning ticket', 'error'); sel.val(sel.data('orig')); });
            }).each(function () {
                $(this).data('orig', $(this).val());
            });

            $('.delete-ticket').click(function () {
                var btn = $(this);
                var ticketId = btn.data('ticketid');
                var title = btn.data('title');
                showConfirm('Delete Ticket', 'Are you sure you want to delete ticket "' + title + '"? This cannot be undone.', 'Delete', function () {
                    $.post('@Url.Action("Delete", "Ticket")', { id: ticketId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                        .done(function (r) {
                            if (r.success) {
                                showToast(r.message, 'success');
                                setTimeout(function () { window.location.reload(); }, 800);
                            } else {
                                showToast(r.message || 'Error deleting ticket', 'error');
                            }
                        })
                        .fail(function () { showToast('Error deleting ticket', 'error'); });
                });
            });
        });
    </script>
}
